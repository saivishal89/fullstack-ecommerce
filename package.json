{
  "name": "fullstack-ecommerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "database",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=shared build",
    "build:server": "npm run --workspace=server build",
    "build:client": "npm run --workspace=client build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "dev:server": "npm run --workspace=server dev",
    "dev:client": "npm run --workspace=client dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "db:generate": "npm run --workspace=database generate",
    "db:push": "npm run --workspace=database push",
    "db:seed": "npm run --workspace=database seed",
    "test": "npm run --workspace=server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
